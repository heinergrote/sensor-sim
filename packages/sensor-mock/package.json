{
  "name": "sensor-mock",
  "version": "0.0.2",
  "description": "Mock browser sensor APIs (starting with Geolocation) with live data streamed from a sensor-sim server, no browser extension required.",
  "keywords": [
    "geolocation",
    "gps",
    "mock",
    "sensor",
    "testing",
    "sensor-sim"
  ],
  "homepage": "https://github.com/heinergrote/sensor-sim/tree/main/packages/sensor-mock#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heinergrote/sensor-sim.git",
    "directory": "packages/sensor-mock"
  },
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "smoke-test": "pnpm build && serve . -l 8899"
  },
  "devDependencies": {
    "serve": "^14.2.6",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3"
  }
}
