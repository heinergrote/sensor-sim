{
  "name": "@sensor-sim/server",
  "type": "module",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "pnpm --filter @sensor-sim/frontend build && pnpm typecheck && tsup && node ./scripts/copy-frontend.mjs",
    "start": "node dist/index.js",
    "migrate": "node dist/migrate.js",
    "migrate:dev": "tsx src/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@hono/zod-validator": "^0.9.1",
    "@sensor-sim/shared": "workspace:*",
    "dotenv": "17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.34",
    "nanoid": "^6.0.1",
    "pg": "^8.23.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "tsup": "^8.5.0",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3"
  }
}