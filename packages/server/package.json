{
  "name": "@sensor-sim/server",
  "type": "module",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "pnpm --filter @sensor-sim/frontend build && pnpm typecheck && tsdown && node ./scripts/copy-frontend.mjs",
    "start": "node dist/index.js",
    "migrate": "node dist/migrate.js",
    "migrate:dev": "tsx src/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@hono/zod-validator": "^0.9.1",
    "@sensor-sim/shared": "workspace:*",
    "dotenv": "18.0.9",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "nanoid": "^6.0.2",
    "pg": "^8.23.1",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "tsdown": "0.23.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}